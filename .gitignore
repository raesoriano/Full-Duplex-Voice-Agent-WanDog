#   download/asr-models/sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2
#   tar xf sherpa-onnx-streaming-zipformer-en-2023-06-26.tar.bz2
models/

# Tool secrets. The tracked template is secrets.example.yaml; the real file
# holds live API keys and must never be committed.
secrets.yaml
secrets.yml
